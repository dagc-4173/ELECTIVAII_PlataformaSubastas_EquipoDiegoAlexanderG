PORT=3000

# Sustituir por un secreto local aleatorio de al menos 32 caracteres.
JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=3600

# Ruta del archivo SQLite, relativa al directorio desde el que se inicia Node.
DATABASE_PATH=./data/auctions.sqlite

# local muestra el enlace en la consola privada del servidor. email usa Resend.
PASSWORD_RESET_MODE=
PASSWORD_RESET_URL=
PASSWORD_RESET_FROM=
RESEND_API_KEY=
